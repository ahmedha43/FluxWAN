#!/bin/sh
clear
echo "======================================================================"
echo "    ███████╗██╗     ██╗   ██╗██╗  ██╗██╗    ██╗ █████╗ ███╗   ██╗     "
echo "    ██╔════╝██║     ██║   ██║╚██╗██╔╝██║    ██║██╔══██╗████╗  ██║     "
echo "    █████╗  ██║     ██║   ██║ ╚███╔╝ ██║ █╗ ██║███████║██╔██╗ ██║     "
echo "    ██╔══╝  ██║     ██║   ██║ ██╔██╗ ██║███╗██║██╔══██║██║╚██╗██║     "
echo "    ██║     ███████╗╚██████╔╝██╔╝ ██╗╚███╔███╔╝██║  ██║██║ ╚████║     "
echo "    ╚═╝     ╚══════╝ ╚═════╝ ╚═╝  ╚═╝ ╚══╝╚══╝ ╚═╝  ╚═╝╚═╝  ╚═══╝     "
echo "             High-Performance Multi-WAN Router Appliance              "
echo "======================================================================"

LAN_IPS=$(ip -4 addr show eth0 2>/dev/null | grep inet | awk '{print $2}' | cut -d/ -f1 | tr '\n' ' ')
if [ -z "$LAN_IPS" ]; then
    LAN_IPS="192.168.90.1 192.168.155.100 192.168.88.200"
fi

PRIMARY_IP=$(echo "$LAN_IPS" | awk '{print $1}')
echo " [*] Primary Web UI      : http://$PRIMARY_IP:8080 (or http://$PRIMARY_IP)"
echo " [*] All Reachable URLs  :"
for tip in $LAN_IPS; do
    echo "     -> http://$tip:8080"
done
echo " [*] SSH Access          : ssh root@$PRIMARY_IP (Password: admin)"
echo " [*] Web UI Credentials  : Username: admin | Password: admin"
echo " [*] Interface Status    :"
for iface in $(ls /sys/class/net 2>/dev/null | grep -v "lo"); do
    state=$(cat "/sys/class/net/$iface/operstate" 2>/dev/null || echo "unknown")
    mac=$(cat "/sys/class/net/$iface/address" 2>/dev/null || echo "")
    echo "     - $iface [$state] MAC: $mac"
done
echo "======================================================================"
