#!/sbin/openrc-run

description="FluxWAN High-Performance Multi-WAN Router Engine"
command="/opt/fluxwan/fluxwan"
command_args="/opt/fluxwan/config/fluxwan.json"
command_background="yes"
pidfile="/run/fluxwan.pid"

depend() {
    need net
    after firewall
}

start_pre() {
    # Kernel tuning for Multi-WAN routing
    sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1 || true
    sysctl -w net.ipv4.conf.all.rp_filter=2 >/dev/null 2>&1 || true
    sysctl -w net.ipv4.conf.default.rp_filter=2 >/dev/null 2>&1 || true

    # Port 80 -> 8080 Web UI redirection
    iptables -t nat -A PREROUTING -p tcp --dport 80 -j REDIRECT --to-port 8080 2>/dev/null || true
}

start_post() {
    # Print welcome splash banner to tty1
    /usr/local/bin/fluxwan-banner > /dev/tty1 2>/dev/null || true
}
