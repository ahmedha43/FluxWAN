#!/bin/sh
# ==============================================================================
# FluxWAN Permanent NAND Flash Installer for MikroTik RB5009
# Target Storage: 1GB Onboard NAND (/dev/mtd5 / ubi0)
# ==============================================================================
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

echo -e "${CYAN}======================================================================${NC}"
echo -e "${CYAN}   FluxWAN RB5009 Permanent NAND Flash Installer                      ${NC}"
echo -e "${CYAN}======================================================================${NC}"

if [ "$(id -u)" -ne 0 ]; then
    echo -e "${RED}[!] ERROR: This script must be run as root.${NC}"
    exit 1
fi

echo -e "${BLUE}[1/5] Detecting NAND Flash MTD Partitions...${NC}"
UBI_MTD=$(grep -i '"ubi"' /proc/mtd | awk -F: '{print $1}' | sed 's/mtd//')

if [ -z "$UBI_MTD" ]; then
    echo -e "${YELLOW}[*] Probing /dev/mtd5 for UBI partition...${NC}"
    UBI_MTD="5"
fi

echo -e "    * Target MTD Partition: /dev/mtd${UBI_MTD}"

echo -e "${BLUE}[2/5] Formatting NAND Flash with UBI Volume Management...${NC}"
# Detach if previously attached
ubiattach /dev/ubi_ctrl -m "$UBI_MTD" 2>/dev/null || true
ubidetach /dev/ubi_ctrl -m "$UBI_MTD" 2>/dev/null || true

ubiformat "/dev/mtd${UBI_MTD}" -y -q
ubiattach /dev/ubi_ctrl -m "$UBI_MTD"

echo -e "${BLUE}[3/5] Creating UBI Volumes (kernel, rootfs, config)...${NC}"
ubimkvol /dev/ubi0 -n 0 -N "kernel" -s 32MiB
ubimkvol /dev/ubi0 -n 1 -N "rootfs" -s 512MiB
ubimkvol /dev/ubi0 -n 2 -N "fluxwan_data" -m

echo -e "${BLUE}[4/5] Flashing Kernel & RootFS into NAND...${NC}"
if [ -f "/boot/Image.gz" ]; then
    ubiupdatevol /dev/ubi0_0 /boot/Image.gz
elif [ -f "/boot/fluxwan-rb5009.itb" ]; then
    ubiupdatevol /dev/ubi0_0 /boot/fluxwan-rb5009.itb
fi

mkdir -p /tmp/ubi_rootfs
mount -t ubifs /dev/ubi0_1 /tmp/ubi_rootfs

echo -e "    * Deploying FluxWAN ARM64 System binaries..."
mkdir -p /tmp/ubi_rootfs/bin /tmp/ubi_rootfs/sbin /tmp/ubi_rootfs/lib /tmp/ubi_rootfs/etc \
         /tmp/ubi_rootfs/usr/bin /tmp/ubi_rootfs/usr/sbin /tmp/ubi_rootfs/usr/lib \
         /tmp/ubi_rootfs/opt/fluxwan/config /tmp/ubi_rootfs/opt/fluxwan/bpf \
         /tmp/ubi_rootfs/usr/local/bin /tmp/ubi_rootfs/boot /tmp/ubi_rootfs/root \
         /tmp/ubi_rootfs/dev /tmp/ubi_rootfs/proc /tmp/ubi_rootfs/sys /tmp/ubi_rootfs/tmp \
         /tmp/ubi_rootfs/run /tmp/ubi_rootfs/var/log /tmp/ubi_rootfs/var/run

cp -a /bin/* /tmp/ubi_rootfs/bin/ 2>/dev/null || true
cp -a /sbin/* /tmp/ubi_rootfs/sbin/ 2>/dev/null || true
cp -a /lib/* /tmp/ubi_rootfs/lib/ 2>/dev/null || true
cp -a /etc/* /tmp/ubi_rootfs/etc/ 2>/dev/null || true
cp -a /usr/bin/* /tmp/ubi_rootfs/usr/bin/ 2>/dev/null || true
cp -a /usr/sbin/* /tmp/ubi_rootfs/usr/sbin/ 2>/dev/null || true
cp -a /usr/lib/* /tmp/ubi_rootfs/usr/lib/ 2>/dev/null || true
cp -a /opt/fluxwan/* /tmp/ubi_rootfs/opt/fluxwan/ 2>/dev/null || true

sync
umount /tmp/ubi_rootfs

echo -e "${BLUE}[5/5] Finalizing RB5009 NAND Installation...${NC}"
sync

echo ""
echo -e "${GREEN}======================================================================${NC}"
echo -e "${GREEN} [?] SUCCESS: FluxWAN Installed to MikroTik RB5009 NAND Flash!        ${NC}"
echo -e "${GREEN}     You can now reboot and remove network boot cable.                ${NC}"
echo -e "${GREEN}======================================================================${NC}"
