#!/bin/sh
clear
echo "======================================================================"
echo "    ███████╗██╗     ██╗   ██╗██╗  ██╗██╗    ██╗ █████╗ ███╗   ██╗     "
echo "    ██╔════╝██║     ██║   ██║╚██╗██╔╝██║    ██║██╔══██╗████╗  ██║     "
echo "    █████╗  ██║     ██║   ██║ ╚███╔╝ ██║ █╗ ██║███████║██╔██╗ ██║     "
echo "    ██╔══╝  ██║     ██║   ██║ ██╔██╗ ██║███╗██║██╔══██║██║╚██╗██║     "
echo "    ██║     ███████╗╚██████╔╝██╔╝ ██╗╚███╔███╔╝██║  ██║██║ ╚████║     "
echo "    ╚═╝     ╚══════╝ ╚═════╝ ╚═╝  ╚═╝ ╚══╝╚══╝ ╚═╝  ╚═╝╚═╝  ╚═══╝     "
echo "             High-Performance Multi-WAN Router Appliance              "
echo "      Developed by Ahmed Al-Dulaimi (أحمد الدليمي) | GNU GPLv3       "
echo "======================================================================"

LAN_IP=$(ip -4 addr show eth0 2>/dev/null | grep inet | awk '{print $2}' | cut -d/ -f1 | head -n1)
if [ -z "$LAN_IP" ]; then
    LAN_IP="192.168.90.1"
fi

echo " [*] Dedicated LAN IP    : $LAN_IP (Subnet: 255.255.255.0 / 24)"
echo " [*] Web Management UI   : http://$LAN_IP:8080 (or http://$LAN_IP)"
echo " [*] DHCP Client Pool    : 192.168.90.100 - 192.168.90.200 (Gateway: $LAN_IP)"
echo " [*] SSH Terminal Access : ssh root@$LAN_IP (Password: admin)"
echo " [*] Web UI Credentials  : Username: admin | Password: admin"
echo " [*] Network Adapters    :"
for iface in $(ls /sys/class/net 2>/dev/null | grep -v "lo"); do
    state=$(cat "/sys/class/net/$iface/operstate" 2>/dev/null || echo "unknown")
    mac=$(cat "/sys/class/net/$iface/address" 2>/dev/null || echo "")
    echo "     - $iface [$state] MAC: $mac"
done
echo "======================================================================"
