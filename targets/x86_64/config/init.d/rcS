#!/bin/sh
# ==============================================================================
# FluxWAN Embedded Network Appliance - Fast Boot Startup Script (/etc/init.d/rcS)
# ==============================================================================

# 1. Mount virtual and temporary filesystems
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mkdir -p /dev/pts /dev/shm /tmp /run /var/log /var/run
mount -t devpts devpts /dev/pts -o gid=5,mode=620 2>/dev/null || true
mount -t tmpfs tmpfs /tmp -o mode=1777 2>/dev/null || true
mount -t tmpfs tmpfs /run 2>/dev/null || true

# 2. Populate device nodes via BusyBox mdev
if [ -x /sbin/mdev ]; then
    echo /sbin/mdev > /proc/sys/kernel/hotplug 2>/dev/null || true
    mdev -s
fi

# 3. Apply Kernel Network & Performance Tuning
if [ -f /etc/sysctl.conf ]; then
    sysctl -p /etc/sysctl.conf >/dev/null 2>&1 || true
fi
sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1 || true
sysctl -w net.ipv4.conf.all.rp_filter=2 >/dev/null 2>&1 || true
sysctl -w net.ipv4.conf.default.rp_filter=2 >/dev/null 2>&1 || true
sysctl -w net.ipv4.conf.all.forwarding=1 >/dev/null 2>&1 || true
sysctl -w net.ipv4.conf.all.arp_ignore=1 >/dev/null 2>&1 || true
sysctl -w net.ipv4.conf.all.arp_announce=2 >/dev/null 2>&1 || true

# 4. Autoload Essential Network & Driver Modules
for mod in loop squashfs ext4 jbd2 crc32c sd_mod ahci nvme usb_storage virtio_net e1000 e1000e igb igc ixgbe i40e ice mlx4_core mlx4_en mlx5_core bnx2x tg3 bnx2 sfc atlantic vmxnet3 r8169 tun tap macvlan ppp_generic ppp_async pppox pppoe xt_conntrack xt_nat xt_MASQUERADE xt_mark xt_statistic xt_TCPMSS xt_LOG sch_cake sch_fq_codel; do
    modprobe "$mod" >/dev/null 2>&1 || true
done

# 5. Loopback Interface
ip link set lo up 2>/dev/null || ifconfig lo 127.0.0.1 up 2>/dev/null || true

# 6. Dedicated LAN Interface (Auto-Detect first ethernet interface or eth0)
LAN_IFACE="eth0"
for iface in $(ls /sys/class/net 2>/dev/null); do
    if [ "$iface" != "lo" ] && [ -d "/sys/class/net/$iface" ]; then
        LAN_IFACE="$iface"
        break
    fi
done

ip link set "$LAN_IFACE" up 2>/dev/null || true
ip addr add 10.10.10.1/24 dev "$LAN_IFACE" 2>/dev/null || ifconfig "$LAN_IFACE" 10.10.10.1 netmask 255.255.255.0 up 2>/dev/null || true

# 7. Web Management Port 80 -> 8080 Redirection
iptables -t nat -A PREROUTING -p tcp --dport 80 -j REDIRECT --to-port 8080 2>/dev/null || true

# 8. Start FluxWAN Core Reactor Daemon
if [ -x /opt/fluxwan/fluxwan ] && [ -f /opt/fluxwan/config/fluxwan.json ]; then
    /opt/fluxwan/fluxwan /opt/fluxwan/config/fluxwan.json > /var/log/fluxwan.log 2>&1 &
fi

# 9. Print Welcome Splash Banner to Console
if [ -x /usr/local/bin/fluxwan-banner ]; then
    /usr/local/bin/fluxwan-banner > /dev/console 2>/dev/null || true
fi
