# /etc/inittab - FluxWAN Network Appliance (Busybox Init - No openrc required)

# System Initialization
::sysinit:/etc/init.d/rcS

# Management Console (TTY1 = VGA/VMware, ttyS0 = Serial/QEMU)
tty1::respawn:/usr/local/bin/fluxwan-menu
ttyS0::respawn:/usr/local/bin/fluxwan-menu
tty2::respawn:/bin/ash

# System Actions
::ctrlaltdel:/sbin/reboot
::shutdown:/etc/init.d/rcK